#_____ Internal Container URLs ___________________________
OLLAMA_BASE_URL=http://ollama:11434
LITELLM_BASE_URL=http://litellm:4000/v1
QDRANT_URL=http://qdrant:6333
MEM0_QDRANT_URL=http://qdrant:6333

#_____ LiteLLM Client ____________________________________
# The local LiteLLM proxy does not currently require authentication.
LITELLM_API_KEY=EMPTY
LITELLM_TIMEOUT=60
LITELLM_MAX_RETRIES=2

#_____ Ollama Models _____________________________________
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT=60

#_____ Mem0 ______________________________________________
MEM0_DIR=/home/appuser/.mem0
MEM0_COLLECTION_NAME=harness_memories
MEM0_LLM_MODEL=qwen3:1.7b
MEM0_EMBEDDER_MODEL=nomic-embed-text
MEM0_HISTORY_DB_PATH=/home/appuser/.mem0/history.db
