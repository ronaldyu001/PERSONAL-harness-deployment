# Internal Container URLs
OLLAMA_BASE_URL=http://ollama:11434
LITELLM_BASE_URL=http://litellm:4000/v1
QDRANT_URL=http://qdrant:6333
MEM0_QDRANT_URL=http://qdrant:6333

# Frontend URLs
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://tauri.localhost,tauri://localhost

# Web Search
LANGSEARCH_API_KEY=api-key

# LiteLLM Client
LITELLM_API_KEY=EMPTY
LITELLM_TIMEOUT=60
LITELLM_MAX_RETRIES=2

# Ollama Models
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT=60

# Mem0
MEM0_DIR=/home/appuser/.mem0
MEM0_COLLECTION_NAME=harness_memories
MEM0_LLM_MODEL=qwen
MEM0_EMBEDDER_MODEL=nomic-embed-text
MEM0_EMBEDDING_DIMS=768
MEM0_HISTORY_DB_PATH=/home/appuser/.mem0/history.db
